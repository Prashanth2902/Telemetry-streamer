---
Language: Cpp
BasedOnStyle: Google
ColumnLimit: 100
IndentWidth: 2
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  # Standard library: <atomic>, <cstdint>, ...
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  # Third-party: <gtest/...>, <nlohmann/...>, <google/protobuf/...>, ...
  - Regex: '^<.*>$'
    Priority: 2
  # Project headers: "tstream/..."
  - Regex: '^"tstream/'
    Priority: 3
  - Regex: '.*'
    Priority: 4
...
